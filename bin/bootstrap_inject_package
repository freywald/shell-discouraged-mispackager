#!/bin/bash

# please do NOT modify this file
# this script is taken from shell-discouraged-mispackager without modifications
# and will be replaced on manual update at any time

# preamble start
set -o errtrace -o pipefail -o noclobber -o nounset
shopt -s inherit_errexit nullglob dotglob

export LC_NUMERIC="en_US.UTF-8"

shopt -s expand_aliases

readonly ARCHIVE_DOWNLOADS_DIRECTORY="archive/downloads"
readonly ARCHIVE_INSTALLATIONS_DIRECTORY="archive/installations"
readonly CONTROL_DIRECTORY="packages.control"
readonly DYNAMIC_FILE="package-paths.export"
readonly SOURCES_FILE="packages.sources"
readonly PINNED_FILE="packages.pinned.sources"

function local_exit_failsafe() { exit 1; }

# preamble end

readonly BOOTSTRAPPER_LOADED=true

if ! declare -p installed_paths &>"/dev/null"; then
	declare -A installed_paths=()
fi

if ! declare -p handler_sourced &>"/dev/null"; then
	declare -A handler_sourced=()
fi

if ! declare -p registered_handlers &>"/dev/null"; then
	declare -A registered_handlers=()
fi

function bootstrap_inject_package() {
	local url="$1" destination="$2"
	shift 2 ||:

	local project_name="" sha256=""
	while (($# > 0)); do
		if [[ "$1" == "--project-name" ]]; then
			if [[ -n "${2-}" && "$2" != --* ]]; then
				project_name="$2"
				shift 2 ||:
			else
				__error "--project-name requires a value"
				local_exit_failsafe
			fi
		elif [[ "$1" == "--project-name="* ]]; then
			project_name="${1#"--project-name="}"
			if [[ -n "$project_name" ]]; then
				shift ||:
			else
				__error "--project-name requires a value"
				local_exit_failsafe
			fi
		elif [[ "$1" == "--sha256" ]]; then
			if [[ -n "${2-}" && "$2" != --* ]]; then
				sha256="$2"
				shift 2 ||:
			else
				__error "--sha256 requires a value"
				local_exit_failsafe
			fi
		elif [[ "$1" == "--sha256="* ]]; then
			sha256="${1#"--sha256="}"
			shift ||:
		else
			__error "unknown argument %s" "$1"
			local_exit_failsafe
		fi
	done

	# Parse GitHub URLs, including /tree/<ref>
	if [[ "$url" =~ ^https://github.com/([^/]+)/([^/]+)(/tree/([^/]+))?/?$ ]]; then
		local owner="${BASH_REMATCH[1]}"
		local repository="${BASH_REMATCH[2]}"
		local ref="${BASH_REMATCH[4]}"
		repository="${repository%".git"}"

		if [[ -z "$project_name" ]]; then
			project_name="$repository"
		fi

		if [[ -n "$ref" ]]; then
			# Commit SHA → /archive/<sha>.zip ; otherwise treat as branch
			if [[ "$ref" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
				download_url="https://github.com/$owner/$repository/archive/$ref.zip"
			else
				download_url="https://github.com/$owner/$repository/archive/refs/heads/$ref.zip"
			fi
		else
			download_url="https://github.com/$owner/$repository/archive/refs/heads/master.zip"
		fi
	else
		download_url="$url"
		if [[ -z "$project_name" ]]; then
			project_name="${url##*/}"
			project_name="${project_name%".git"}"
			project_name="${project_name%".zip"}"
		fi
	fi

	project_name="${project_name//"-"/"_"}"
	destination="$(__normalize_path_slashes "$destination/$project_name")"

	printf -v "__${project_name}_package_path" '%s/' "$destination"

	__verbose "resolved bootstrap for %s → %s" "$project_name" "$download_url"

	if [[ -d "$destination" ]]; then
		local settings_file="$destination/installation-settings.markdown"
		local incomplete=false
		# Treat as incomplete if settings are missing or the tree looks like a partial download
		# (e.g. only a scripts/install file was placed by an outer bootstrap).
		if [[ ! -f "$settings_file" ]]; then
			incomplete=true
		elif ! grep -q '^- bootstrapped:' "$settings_file" 2>"/dev/null"; then
			incomplete=true
		fi

		if $incomplete; then
			__info "existing bootstrap for %s looks incomplete, archiving and forcing re-install" "$project_name"
			local archive_directory
			archive_directory="$installation_root/$ARCHIVE_INSTALLATIONS_DIRECTORY"
			mkdir --parents -- "$archive_directory"
			local stamp
			stamp="$(date +%d-%m-%Y-%H-%M-%S)"
			local archived
			archived="$archive_directory/$project_name-incomplete-$stamp"
			local index=1
			while [[ -e "$archived" ]]; do
				archived="$archive_directory/$project_name-incomplete-${stamp}_$index"
				index="$((index + 1))" ||:
			done
			mv -- "$destination" "$archived"
			__info "moved incomplete %s -> %s" "$destination" "$archived"
		else
			__info "Bootstrapping %s not necessary… skipped." "$project_name"
			# Ensure the marker exists even if settings were deleted
			if [[ ! -f "$settings_file" ]]; then
				{
					printf '%s\n' "# installation settings" ""
					printf '%s\n' "- source url: ${url}"
					printf '%s\n' "- download url: ${download_url}"
					printf '%s\n' "- bootstrapped: true"
					printf '%s\n' "- installed at: $(date +%d-%m-%Y-%H-%M-%S)"
				} >| "$settings_file"
			elif ! grep -q '^- bootstrapped:' "$settings_file"; then
				printf '%s\n' "- bootstrapped: true" >> "$settings_file"
			fi
		fi
	fi

	if [[ ! -d "$destination" ]]; then
		__info "bootstrapping %s from %s" "$project_name" "$download_url"
		temporary_directory="$(__create_temporary_directory)"
		local status=0
		curl -fL --retry 3 --retry-delay 2 --output "$temporary_directory/archive.zip" -- "$download_url" || status="$(__abort_on_interrupt "$?")"
		if (( status != 0 )); then
			[[ -d "$temporary_directory" ]] && rm --recursive --force -- "$temporary_directory"
			__error "download failed: %s" "$download_url"
			local_exit_failsafe
		fi

		local actual
		actual="$(sha256sum -- "$temporary_directory/archive.zip" | awk '{print $1}')"
		__info "sha256 of %s: %s" "$project_name" "$actual"

		if [[ -n "$sha256" ]]; then
			if [[ "$actual" != "$sha256" ]]; then
				[[ -d "$temporary_directory" ]] && rm --recursive --force -- "$temporary_directory"
				__error "sha256 mismatch for %s: expected %s, got %s" "$project_name" "$sha256" "$actual"
				local_exit_failsafe
			fi

			__info "sha256 verified for %s" "$project_name"
		fi

		__info "extracting %s" "$project_name"
		status=0
		unzip -q -d "$temporary_directory/extracted" -- "$temporary_directory/archive.zip" || status="$(__abort_on_interrupt "$?")"
		if (( status != 0 )); then
			[[ -d "$temporary_directory" ]] && rm --recursive --force -- "$temporary_directory"
			__error "extract failed: %s" "$download_url"
			local_exit_failsafe
		fi

		mkdir --parents -- "$destination"
		local entries=("$temporary_directory/extracted/"*)
		if (( ${#entries[@]} == 1 )) && [[ -d "${entries[0]}" ]]; then
			mv -- "${entries[0]}/"* "$destination/"
		else
			mv -- "$temporary_directory/extracted/"* "$destination/"
		fi

		cat > "$destination/installation-settings.markdown" <<EOF
# installation settings

- source url: ${url}
- download url: ${download_url}
- sha256: ${sha256}
- install directory: ${destination}
- installed at: $(date +%d-%m-%Y-%H-%M-%S)
- bootstrapped: true
EOF

		[[ -d "$temporary_directory" ]] && rm --recursive --force -- "$temporary_directory"
		__info "bootstrapped %s to %s" "$project_name" "$destination"
	fi

	installed_paths["$project_name"]="$destination"

	local runtime_file="$installation_root/bootstrapped.dynamic"
	mkdir --parents -- "$(dirname -- "$runtime_file")"
	local rel="${destination#"$installation_root"/}"
	rel="${rel#"$installation_root"}"
	rel="${rel#/}"
	local line
	line="$(printf '__%s_package_path="$installation_root/%s"\n' "$project_name" "$(__normalize_path_slashes "$rel/")")"
	if [[ ! -f "$runtime_file" ]] || ! grep -qF -- "$line" "$runtime_file"; then
		printf '%s\n' "$line" >> "$runtime_file"
		__verbose "recorded library path for %s" "$project_name"
	fi

	local handler
	handler="$destination/$CONTROL_DIRECTORY/$project_name"
	if [[ -f "$handler" ]]; then
		__info "sourcing post-installation handler %s" "$handler"
		if [[ "$(type -t "__require_once")" != "function" ]]; then
			if ! source -- "$handler"; then
				__error "(fallback) handler file failed to source: %s" "$handler"
				local_exit_failsafe
			fi
		else
			__require_once "$handler"
		fi
		handler_sourced["$project_name"]=1
	fi
}

function __normalize_path_slashes()
{
	local s="${1:?${FUNCNAME[0]}: expected argument path}"
	while [[ "$s" == *//* ]]; do
		s="${s//\/\//\/}"
	done
	echo "$s"
}

function __create_temporary_directory() {
	local prefix
	prefix="$(basename -- "$0")"

	mktemp --directory -- "${TMPDIR:-"/tmp/"}/${prefix}.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
}

function __error() { printf -- "$@"; echo; exit 1; }
function __info() { printf -- "[INFO] $@"; echo; }
function __verbose() { printf -- "[VERBOSE] $@"; echo; }

EXIT_OK=0
EXIT_INTERRUPTED=130   # 128 + SIGINT
EXIT_TERMINATED=143   # 128 + SIGTERM
function __abort_on_interrupt() {
	local status="${1:-$?}"
	set +x

	if (( status == EXIT_INTERRUPTED || status == EXIT_TERMINATED )); then
		exit "$status"
	fi

	if (( status > 0 )); then
		printf '%s\n' "$status"

		return 0
	fi

	printf '%s\n' "$EXIT_OK"

	return 0
}

function register_handler() {
	local id="$1" function_name="$2"

	if [[ -n "${registered_handlers["$id"]-}" ]]; then
		return 0
	fi

	registered_handlers["$id"]="$function_name"
}

if [[ -z "${installation_root:-}" ]]; then
	__error "installation_root is empty or not set"
	local_exit_failsafe
fi
