#!/bin/bash

# configuration start


# configuration end

function local_exit_failsafe() { __exit_failsafe; exit 1; }

# task start

if ! declare -p installation_root &>"/dev/null"; then
	installation_root=""
fi

branch_primary="master"
force_installation_all=false
force_download_newer=false
update_to_any_depth=false
update_pinned=false
backup_destination=""

readonly EXIT_REBOOT=12

# seen: project -> installed|checked|failed
# decided_version: project -> identity string
# decided_by: project -> who requested it
declare -A seen=()
declare -A decided_version=()
declare -A decided_by=()
declare -a queue=()
declare -A pinned_commits=()
declare -A pinned_urls=()
declare -A processed_files=()

if ! declare -p installed_paths &>"/dev/null"; then
	declare -A installed_paths=()
fi

if ! declare -p registered_handlers &>"/dev/null"; then
	declare -A registered_handlers=()
fi

if ! declare -p handler_sourced &>"/dev/null"; then
	declare -A handler_sourced=()
fi

function date_stamp_from_path() {
	local path="$1"
	date -d "@$(stat --format "%Y" -- "$path")" "+%d-%m-%Y-%H-%M-%S"
}

function unique_destination() {
	local destination="$1"
	local index=1

	local candidate="$destination"
	while [[ -e "$candidate" ]]; do
		candidate="${destination}_$index"
		index="$((index + 1))" ||__expression_may_fail
	done

	printf '%s\n' "$candidate"
}

function version_from_text() {
	local text="$1"
	local version=""

	# Prefer an explicit tag-like token (optional leading v, semver-ish, optional pre-release)
	# Stops at the first non-version character that is not part of a pre-release suffix.
	if [[ "$text" =~ (^|[^A-Za-z0-9])(v?[0-9]+([.][0-9]+){1,3}([-.][A-Za-z0-9]+)*)([^A-Za-z0-9]|$) ]]; then
		version="${BASH_REMATCH[2]}"
		# Strip a trailing non-version character that the regex may have included
		version="${version%%[^A-Za-z0-9.-]*}"
		# Reject pure numbers that are too short to be versions (e.g. just "1")
		if [[ ! "$version" =~ [.] ]]; then
			version=""
		fi
	fi

	printf '%s\n' "$version"
}

function settings_value() {
	local file="$1" key="$2"
	[[ ! -f "$file" ]] && return 0

	sed -n "s/^[[:space:]]*- $key: //p" -- "$file" | head -n 1
}

function parse_requirement() {
	local url="$1"
	url="${url%%"#"*}"
	url="${url%%\?*}"
	url="${url%"/"}"

	requirement_url="$url"
	requirement_kind=""
	requirement_host=""
	requirement_owner=""
	requirement_repository=""
	requirement_page=""
	requirement_branch=""
	requirement_tag=""
	requirement_version=""
	requirement_download=""
	requirement_commit=""
	requirement_explicit=false
	requirement_sha256=""

	if [[ "$url" =~ ^https://github.com/([^/]+)/([^/]+)(.*)$ ]]; then
		requirement_kind="github"
		requirement_host="github.com"
		requirement_owner="${BASH_REMATCH[1]}"
		requirement_repository="${BASH_REMATCH[2]}"
		requirement_repository="${requirement_repository%".git"}"
		requirement_page="https://github.com/$requirement_owner/$requirement_repository"
		local rest="${BASH_REMATCH[3]}"
		rest="${rest%"/"}"
		if [[ "$rest" =~ ^/tree/(.+)$ ]]; then
			local ref="${BASH_REMATCH[1]}"
			# 7–40 hex chars = commit SHA (full or abbreviated)
			if [[ "$ref" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
				requirement_commit="$ref"
				requirement_explicit=true
			else
				requirement_branch="$ref"
				requirement_explicit=true
			fi
		elif [[ "$rest" =~ ^/archive/refs/heads/(.+)[.]zip$ ]]; then
			requirement_branch="${BASH_REMATCH[1]}"
			requirement_explicit=true
		elif [[ "$rest" =~ ^/archive/refs/tags/(.+)[.]zip$ ]]; then
			requirement_tag="${BASH_REMATCH[1]}"
			requirement_explicit=true
		elif [[ "$rest" =~ ^/archive/(.+)[.]zip$ ]]; then
			requirement_branch="${BASH_REMATCH[1]}"
			requirement_explicit=true
		elif [[ -n "$rest" && "$rest" != ".git" ]]; then
			return 1
		fi

		return 0
	fi

	if [[ "$url" =~ [.]zip$ ]]; then
		requirement_kind="zip"
		requirement_download="$url"
		requirement_version="$(version_from_text "${url##*/}")"
		requirement_explicit=true

		return 0
	fi

	return 1
}

function latest_release_tag() {
	local owner="$1" repository="$2" tag
	local status=0
	tag="$(curl -fsSL --proto '=https' --tlsv1.2 -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' "https://api.github.com/repos/$owner/$repository/releases/latest" 2>"/dev/null" | python3 -c 'import json,sys
try:
	print(json.load(sys.stdin).get("tag_name") or "")
except Exception:
	print("")
')" || status="$(__abort_on_interrupt "$?")"
	if (( status != 0 && status != 22 )); then
		return "$status"
	fi

	printf '%s\n' "$tag"
}

function branch_commit() {
	local page="$1" branch="$2" commit_hash status=0
	commit_hash="$(git ls-remote "$page.git" "refs/heads/$branch" 2>"/dev/null" | awk '{print $1; exit}')" || status="$(__abort_on_interrupt "$?")"
	if (( status != 0 )) || [[ -z "$commit_hash" ]]; then
		return 1
	fi
	printf '%s\n' "$commit_hash"
}

function update_pin_commit() {
	local name="$1" new_commit="$2"
	[[ ! -f "$pinned_file" || ! -s "$pinned_file" ]] && return 0

	local temporary
	temporary="$(__create_temporary_file)"
	local current="" seen_commit=false line
	while IFS= read -r line || [[ -n "$line" ]]; do
		if [[ "$line" =~ ^#\ name=([A-Za-z0-9_]+)$ ]]; then
			# previous block had no commit line: insert one before the next name
			if [[ -n "$current" && "$current" == "$name" && "$seen_commit" == false ]]; then
				printf '# commit=%s\n' "$new_commit" >> "$temporary"
			fi
			current="${BASH_REMATCH[1]}"
			seen_commit=false
			printf '%s\n' "$line" >> "$temporary"
		elif [[ "$current" == "$name" && "$line" =~ ^#\ commit= ]]; then
			printf '# commit=%s\n' "$new_commit" >> "$temporary"
			seen_commit=true
		else
			printf '%s\n' "$line" >> "$temporary"
		fi
	done < "$pinned_file"

	# block was the last one and had no commit line
	if [[ "$current" == "$name" && "$seen_commit" == false ]]; then
		printf '# commit=%s\n' "$new_commit" >> "$temporary"
	fi

	mv -f -- "$temporary" "$pinned_file"
}

function resolve_download() {
	local saved_commit="$requirement_commit"
	requirement_commit=""
	latest_tag=""

	if [[ "$requirement_kind" == "zip" ]]; then
		__verbose "using direct zip for %s: %s" "$requirement_project" "$requirement_download"
		return 0
	fi

	if [[ -n "$saved_commit" ]]; then
		requirement_commit="$saved_commit"
		requirement_download="$requirement_page/archive/$requirement_commit.zip"
		local full status=0
		full="$(git ls-remote "$requirement_page.git" "$requirement_commit" 2>"/dev/null" | awk '{print $1; exit}')" || status="$(__abort_on_interrupt "$?")"
		if (( status != 0 )); then
			__error "failed to resolve commit %s for %s" "$requirement_commit" "$requirement_project"
			local_exit_failsafe
		fi
		[[ -n "$full" ]] && requirement_commit="$full"
		__verbose "using pinned commit for %s: %s" "$requirement_project" "$requirement_commit"
		return 0
	fi

	if $force_download_newer || [[ -z "$requirement_tag" && -z "$requirement_branch" ]]; then
		latest_tag="$(latest_release_tag "$requirement_owner" "$requirement_repository")"
		__verbose "queried latest release for %s: %s" "$requirement_project" "${latest_tag:-"(none)"}"
	fi

	if [[ -n "$requirement_tag" ]]; then
		requirement_download="$requirement_page/archive/refs/tags/$requirement_tag.zip"
		requirement_version="$(version_from_text "$requirement_tag")"
		__verbose "using explicit tag for %s: %s" "$requirement_project" "$requirement_tag"

		return 0
	fi

	if [[ -n "$requirement_branch" ]]; then
		requirement_download="$requirement_page/archive/refs/heads/$requirement_branch.zip"
		if ! requirement_commit="$(branch_commit "$requirement_page" "$requirement_branch")"; then
			__error "failed to resolve branch %s for %s" "$requirement_branch" "$requirement_project"
			local_exit_failsafe
		fi
		__verbose "using branch for %s: %s (%s)" "$requirement_project" "$requirement_branch" "$requirement_commit"

		return 0
	fi

	if [[ -n "$latest_tag" ]]; then
		requirement_tag="$latest_tag"
		requirement_download="$requirement_page/archive/refs/tags/$requirement_tag.zip"
		requirement_version="$(version_from_text "$requirement_tag")"
		__info "selected latest release %s for %s" "$latest_tag" "$requirement_project"

		return 0
	fi

	requirement_branch="$branch_primary"
	requirement_download="$requirement_page/archive/refs/heads/$requirement_branch.zip"
	if ! requirement_commit="$(branch_commit "$requirement_page" "$requirement_branch")"; then
		__error "failed to resolve primary branch %s for %s" "$branch_primary" "$requirement_project"
		local_exit_failsafe
	fi
	__info "falling back to primary branch %s for %s" "$branch_primary" "$requirement_project"
}

function notify_newer() {
	[[ "$requirement_kind" != "github" || -z "$latest_tag" ]] && return 0

	if $requirement_explicit; then
		if [[ -n "$requirement_tag" && "$latest_tag" != "$requirement_tag" ]]; then
			__info "pinned to %s for %s; newer release %s is available" "$requirement_tag" "$requirement_project" "$latest_tag"
		elif [[ -n "$requirement_branch" ]]; then
			__info "pinned to branch %s for %s; newer release %s is available" "$requirement_branch" "$requirement_project" "$latest_tag"
		else
			__info "pinned to %s for %s" "${requirement_tag:-"$requirement_branch"}" "$requirement_project"
		fi

		return 0
	fi

	if [[ -n "$requirement_tag" && "$latest_tag" != "$requirement_tag" ]]; then
		__info "newer release %s is available for %s; staying on %s" "$latest_tag" "$requirement_project" "$requirement_tag"
	fi
}

function apply_force_download_newer() {
	! $force_download_newer && return 0

	[[ "$requirement_kind" != "github" || -z "$latest_tag" ]] && return 0

	if [[ -n "$requirement_tag" && "$latest_tag" == "$requirement_tag" ]]; then
		return 0
	fi

	# Without --update-pinned, leave explicit tags alone
	if [[ -n "$requirement_tag" && ! $update_pinned ]]; then
		return 0
	fi

	if [[ -z "$requirement_tag" && -z "$requirement_branch" ]]; then
		return 0
	fi

	__info "update %s from %s to release %s" "$requirement_project" "${requirement_tag:-"$requirement_branch"}" "$latest_tag"

	requirement_branch=""
	requirement_commit=""
	requirement_tag="$latest_tag"
	requirement_download="$requirement_page/archive/refs/tags/$requirement_tag.zip"
	requirement_version="$(version_from_text "$requirement_tag")"
	requirement_explicit=true
}

function same_install() {
	[[ ! -d "$target_library_path" ]] && return 1

	local installed_commit="${pinned_commits["$requirement_project"]-}"

	if [[ -z "$requirement_commit" && -f "$target_library_path/installation-settings.markdown" ]]; then
		local installed_tag installed_version
		installed_tag="$(settings_value "$target_library_path/installation-settings.markdown" "tag")"
		installed_version="$(settings_value "$target_library_path/installation-settings.markdown" "version")"
		if [[ -n "$requirement_tag" && "$installed_tag" == "$requirement_tag" ]]; then
			__verbose "same install: tag %s matches for %s" "$requirement_tag" "$requirement_project"
			return 0
		fi
		if [[ -n "$requirement_version" && "$installed_version" == "$requirement_version" ]]; then
			__verbose "same install: version %s matches for %s" "$requirement_version" "$requirement_project"
			return 0
		fi
	fi

	if [[ -n "$requirement_commit" ]]; then
		if [[ -n "$installed_commit" && "$installed_commit" == "$requirement_commit" ]]; then
			__verbose "same install: commit %s matches for %s" "$requirement_commit" "$requirement_project"
			return 0
		fi
		return 1
	fi

	local installed_url="${pinned_urls["$requirement_project"]-}"
	if [[ "$installed_url" == "$requirement_download" ]]; then
		__verbose "same install: download URL matches for %s" "$requirement_project"
		return 0
	fi
	return 1
}

function record_library() {
	if grep -q -- "^__${requirement_project}_library_path=" "$dynamic_partial"; then
		return 0
	fi

	[[ -n "$requirement_commit" ]] && printf '# commit=%s\n' "$requirement_commit" >> "$dynamic_partial"

	if [[ -n "$requirement_version" ]]; then
		printf '# version="%s"\n' "$requirement_version" >> "$dynamic_partial"
	elif [[ -n "$requirement_tag" ]]; then
		printf '# version="%s"\n' "$requirement_tag" >> "$dynamic_partial"
	elif [[ -n "$requirement_branch" ]]; then
		printf '# version="%s"\n' "$requirement_branch" >> "$dynamic_partial"
	fi

	local rel="${target_library_path#"$installation_root"/}"
	rel="${rel#"$installation_root"}"
	rel="${rel#/}"
	printf '__%s_library_path="$installation_root/%s"\n' "$requirement_project" "$(__normalize_path_slashes "$rel/")" >> "$dynamic_partial"
	__verbose "recorded library path for %s" "$requirement_project"
}

function record_pin() {
	if grep -q -- "^# name=$requirement_project$" "$pinned_partial"; then
		return 0
	fi

	printf '# name=%s\n# _type=package\n' "$requirement_project" >> "$pinned_partial"
	[[ "$entry_installation_root" != "$installation_root" ]] && printf '# installation_root=%s\n' "$entry_installation_root" >> "$pinned_partial"
	[[ "$entry_installation_path" != "library" ]] && printf '# installation_path=%s\n' "$entry_installation_path" >> "$pinned_partial"
	[[ -n "$requirement_commit" ]] && printf '# commit=%s\n' "$requirement_commit" >> "$pinned_partial"
	[[ -n "${requirement_sha256:-}" ]] && printf '# sha256=%s\n' "$requirement_sha256" >> "$pinned_partial"
	printf '%s\n\n' "$requirement_download" >> "$pinned_partial"
	__verbose "recorded pin for %s" "$requirement_project"
}

function backup_installation_directory() {
	local path="$1" name="$2"
	mkdir --parents -- "$installation_archive_directory"

	backup_destination="$(unique_destination "$installation_archive_directory/$name-$(date_stamp_from_path "$path")")"
	mv -- "$path" "$backup_destination"

	__info "moved previous install %s -> %s" "$path" "$backup_destination"
}

function extract_zip() {
	local zip="$1" destination="$2"
	local temporary_directory top
	temporary_directory="$(__create_temporary_directory)"
	local status=0
	unzip -q -d "$temporary_directory" -- "$zip" || status="$(__abort_on_interrupt "$?")"
	if (( status != 0 )); then
		[[ -d "$temporary_directory" ]] && rm -rf -- "$temporary_directory"
		return "$status"
	fi

	top="$(find "$temporary_directory" -mindepth 1 -maxdepth 1 -type d -print -quit)"

	if [[ -n "$top" && -z "$(find "$temporary_directory" -mindepth 1 -maxdepth 1 ! -name "$(basename -- "$top")" -print -quit)" ]]; then
		mv -- "$top" "$destination"
	else
		mkdir --parents -- "$destination"
		find "$temporary_directory" -mindepth 1 -maxdepth 1 -exec mv -- {} "$destination/" \;
	fi

	[[ -d "$temporary_directory" ]] && rm -rf -- "$temporary_directory"
}

function archive_zip() {
	local zip="$1" stem="$2"
	mkdir --parents -- "$zip_archive_directory"

	local destination
	destination="$(unique_destination "$zip_archive_directory/$stem-$(date_stamp_from_path "$zip").zip")"
	mv -- "$zip" "$destination"
	archived_zip="$destination"

	__info "archived zip %s" "$destination"
}

function write_installation_settings() {
	local destination="$1"
	cat > "$destination/installation-settings.markdown" <<EOF
# installation settings

- source url: ${requirement_url}
- project: ${requirement_project}
- kind: ${requirement_kind}
- host: ${requirement_host}
- owner: ${requirement_owner}
- repository: ${requirement_repository}
- repository page: ${requirement_page}
- branch: ${requirement_branch}
- tag: ${requirement_tag}
- version: ${requirement_version}
- commit: ${requirement_commit}
- sha256: ${requirement_sha256:-}
- download url: ${requirement_download}
- zip archive: ${archived_zip}
- install directory: ${destination}
- installed at: $(date +%d-%m-%Y-%H-%M-%S)
EOF
}

function abandon_partial() {
	local status="${1:-"$EXIT_INTERRUPTED"}"
	[[ -n "${installation_zip-}" && -f "$installation_zip" ]] && rm -f -- "$installation_zip"
	if ! $installation_complete && [[ -n "${installation_target-}" && -d "$installation_target" ]]; then
		backup_installation_directory "$installation_target" "${requirement_project:-"partial"}"
	fi

	[[ -n "${dynamic_partial-}" && -f "$dynamic_partial" ]] && rm -f -- "$dynamic_partial"
	[[ -n "${pinned_partial-}" && -f "$pinned_partial"  ]] && rm -f -- "$pinned_partial"

	exit "$status"
}

function record_requirement_pin() {
	local name="$1" program="$2" apt="$3"
	printf '# name=%s\n# _type=requirement\n' "$name" >> "$pinned_partial"
	[[ -n "$program" ]] && printf '# program=%s\n' "$program" >> "$pinned_partial"
	[[ -n "$apt" ]] && printf '# apt=%s\n' "$apt" >> "$pinned_partial"
	printf '\n' >> "$pinned_partial"
	__verbose "recorded requirement pin for %s" "$name"
}

function check_requirement() {
	local name="$1" program="$2" apt="$3"

	if [[ -n "$program" ]]; then
		if __test_program_exists "$program"; then
			__info "requirement satisfied by program %s" "$program"
			record_requirement_pin "$name" "$program" "$apt"
			seen["program:$program"]="checked"
			return 0
		fi
		__verbose "program %s not found, trying apt fallback" "$program"
	fi

	if [[ -n "$apt" ]]; then
		if __test_apt_package_exists "$apt"; then
			__info "requirement satisfied by apt package %s" "$apt"
			record_requirement_pin "$name" "$program" "$apt"
			seen["apt:$apt"]="checked"
			return 0
		fi
	fi

	__error "requirement not satisfied (program=%s, apt=%s)" "${program:-"(none)"}" "${apt:-"(none)"}"
	local_exit_failsafe
}

function requirement_identity() {
	if [[ -n "$requirement_tag" ]]; then
		printf '%s' "$requirement_tag"
	elif [[ -n "$requirement_branch" ]]; then
		printf '%s' "branch:$requirement_branch"
	elif [[ -n "$requirement_version" ]]; then
		printf '%s' "$requirement_version"
	else
		printf '%s' "$requirement_download"
	fi
}

function record_decision() {
	local project="$1" identity="$2" requester="$3"
	decided_version["$project"]="$identity"
	decided_by["$project"]="$requester"
}

function check_conflict() {
	local project="$1" identity="$2" requester="$3"

	if [[ -z "${decided_version["$project"]-}" ]]; then
		record_decision "$project" "$identity" "$requester"
		return 0
	fi

	if [[ "${decided_version["$project"]}" == "$identity" ]]; then
		return 0
	fi

	__error "version conflict for %s: %s wants %s, %s wants %s" "$project" "${decided_by["$project"]}" "${decided_version["$project"]}" "$requester" "$identity"
	local_exit_failsafe
}

function register_handler() {
	local id="$1" function_name="$2"

	if [[ -n "${registered_handlers["$id"]-}" ]]; then
		return 0
	fi

	registered_handlers["$id"]="$function_name"
}

function run_handlers() {
	local id function_name status failed=0

	for id in "${!registered_handlers[@]}"; do
		cd -- "$__script_path/"
		function_name="${registered_handlers["$id"]}"
		__info "running handler %s (%s) at: %s" "$id" "$function_name" "$PWD"

		status=0
		"$function_name" || status="$(__abort_on_interrupt "$?")"
		if (( status != 0 )); then
			__warn "handler %s failed with status %s" "$id" "$status"
			failed=1
		fi
	done

	return "$failed"
}

function enqueue_nested() {
	local library_path="$1" depth="$2"

	local nested=""
	if [[ -f "$library_path/$PINNED_FILE" ]] && ! $force_download_newer; then
		nested="$library_path/$PINNED_FILE"
	elif [[ -f "$library_path/$SOURCES_FILE" ]]; then
		nested="$library_path/$SOURCES_FILE"
	fi

	[[ -z "$nested" ]] && return 0

	__verbose "enqueueing nested requirements from %s (depth %s)" "$library_path" "$depth"
	queue+=("$nested"$'\t'"$depth"$'\t'"$(basename -- "$library_path")")
}

function process_requirement() {
	local file="$1" depth="$2" requester="${3:-"top-level"}"

	if [[ ! -f "$file" ]]; then
		__error "requirements file not found: %s" "$file"
		local_exit_failsafe
	fi

	# Skip a sources file that has already been processed this run
	if [[ -n "${processed_files["$file"]-}" ]]; then
		return 0
	fi
	processed_files["$file"]=1

	__heading "Parsing sources"
	__info "Parsing file %s…" "$file"
	parse_sources_file "$file" --new-line-format || __failure "Parsing failed!"
	if ! validate_tree; then
		__failure "Validating sources failed!"
		 if ! $print_sources; then
			__error "Tree validation failed!"
			local_exit_failsafe
		fi
	fi

	__success "Parsing completed."

	if $print_sources; then
		print_tree true true
		__info "[%s] done." "__$__current_script_name"
		exit 0
	fi

	$__debug && print_tree true true

	__info "Reading input. Generating tree…"
	generate_tree
	__info "Generating tree… done."

	local key
	for key in "${tree_order[@]}"; do
		local name type value
		name="$(get_metadata "name" "$key")" || name=""
		type="$(get_metadata "_type" "$key")" || type=""
		commit="$(get_metadata "commit" "$key")" || commit=""
		value="$(get_metadata "_" "$key")" || value=""

		entry_installation_root="$(get_metadata "installation_root" "$key")" || entry_installation_root=""
		entry_installation_path="$(get_metadata "installation_path" "$key")" || entry_installation_path=""

		entry_installation_root="$(__trim_whitespaces "$entry_installation_root")"
		entry_installation_path="$(__trim_whitespaces "$entry_installation_path")"

		[[ -z "$entry_installation_root" ]] && entry_installation_root="$installation_root"
		[[ -z "$entry_installation_path" ]] && entry_installation_path="library"

		entry_installation_root="${entry_installation_root%"/"}"
		entry_installation_path="${entry_installation_path%"/"}"
		entry_installation_path="${entry_installation_path#"/"}"

		[[ -z "$value" && "$type" != "requirement" ]] && continue

		name="$(__trim_whitespaces "$name")"
		type="$(__trim_whitespaces "$type")"
		value="$(__trim_whitespaces "$value")"

		if [[ -z "$type" && "$value" == "http"* ]]; then
			type="package"
		fi

		case "$type" in
			"requirement")
				local req_program req_apt req_name
				req_program="$(get_metadata "program" "$key")" || req_program=""
				req_apt="$(get_metadata "apt" "$key")" || req_apt=""
				req_program="$(__trim_whitespaces "$req_program")"
				req_apt="$(__trim_whitespaces "$req_apt")"
				req_name="${name:-"${req_program:-"$req_apt"}"}"

				check_requirement "$req_name" "$req_program" "$req_apt"
				continue
				;;
			"package"|"")
				;;
			*)
				__error "unknown _type %s in %s" "$type" "$file"
				local_exit_failsafe
				;;
		esac

		local project="$name"
		if [[ -z "$project" || "$project" == *[!A-Za-z0-9_]* ]]; then
			__error "project name missing or not sanitized in %s: %s" "$file" "$value"
			local_exit_failsafe
		fi

		[[ -n "$name" && -n "$commit" ]] && pinned_commits["$name"]="$commit"
		[[ -n "$name" ]] && pinned_urls["$name"]="$value"

		__info "Requirement: %s" "$value"

		requirement_url=""
		requirement_kind=""
		requirement_host=""
		requirement_owner=""
		requirement_repository=""
		requirement_page=""
		requirement_branch=""
		requirement_tag=""
		requirement_version=""
		requirement_download=""
		requirement_commit=""
		requirement_explicit=false
		requirement_sha256=""
		latest_tag=""
		archived_zip=""
		requirement_project="$project"

		if ! parse_requirement "$value"; then
			__error "cannot parse requirement %s in %s" "$value" "$file"
			local_exit_failsafe
		fi

		local entry_tag entry_branch entry_sha256
		entry_tag="$(get_metadata "tag" "$key")" || entry_tag=""
		entry_branch="$(get_metadata "branch" "$key")" || entry_branch=""
		entry_sha256="$(get_metadata "sha256" "$key")" || entry_sha256=""
		entry_tag="$(__trim_whitespaces "$entry_tag")"
		entry_branch="$(__trim_whitespaces "$entry_branch")"
		entry_sha256="$(__trim_whitespaces "$entry_sha256")"

		if [[ -n "$entry_tag" ]]; then
			requirement_tag="$entry_tag"
			requirement_branch=""
			requirement_explicit=true
		elif [[ -n "$entry_branch" ]]; then
			requirement_branch="$entry_branch"
			requirement_tag=""
			requirement_explicit=true
		fi
		requirement_sha256="$entry_sha256"

		if ! resolve_download; then
			exit 1
		fi

		if (( depth == 0 )) || $update_to_any_depth; then
			apply_force_download_newer
		fi

		notify_newer

		local identity
		identity="$(requirement_identity)"
		check_conflict "$project" "$identity" "$requester"

		local handlers_directory handler
		handlers_directory="$(dirname -- "$file")/$CONTROL_DIRECTORY"
		handler="$handlers_directory/$project"

		if [[ ! -f "$handler" && -n "${installed_paths["$project"]-}" ]]; then
			handler="${installed_paths["$project"]}/$CONTROL_DIRECTORY/$project"
		fi

		if [[ -f "$handler" ]]; then
			__info "sourcing post-installation handler %s" "$handler"
			__require_once "$handler"
			handler_sourced["$project"]=1
		fi

		local is_bootstrapped=false
		if [[ -n "${installed_paths["$project"]-}" ]]; then
			[[ "$(settings_value "${installed_paths["$project"]}/installation-settings.markdown" "bootstrapped")" == "true" ]] && is_bootstrapped=true
		fi

		if [[ -n "${installed_paths["$project"]-}" ]] && { ! $force_download_newer || $is_bootstrapped; }; then
			target_library_path="${installed_paths["$project"]}"
			target_library_path="$(__normalize_path_slashes "$target_library_path/")"

			if [[ -d "$target_library_path/" ]]; then
				if $is_bootstrapped && $force_download_newer; then
					__info "bootstrapped package %s is managed by core update, skipping" "$project"
				else
					__info "already installed at %s, skipping %s" "$target_library_path" "$project"
				fi

				record_pin
				record_library
				seen["$project"]="installed"

				local depth_next
				depth_next="$((depth + 1))" || __expression_may_fail
				enqueue_nested "$target_library_path" "$depth_next"

				continue
			fi
		fi

		if [[ -n "${seen["$project"]-}" ]]; then
			continue
		fi

		record_pin

		if [[ -n "${installed_paths["$project"]-}" ]]; then
			target_library_path="${installed_paths["$project"]}"
		else
			target_library_path="$entry_installation_root/$entry_installation_path/$project"
		fi
		target_library_path="$(__normalize_path_slashes "$target_library_path")"
		installation_target=""
		installation_zip=""
		installation_complete=false

		if [[ -L "$target_library_path" ]]; then
			__info "already locally linked, skipping external install of %s" "$project"
			record_library
			seen["$project"]="installed"

			local depth_next
			depth_next="$((depth + 1))" || __expression_may_fail
			enqueue_nested "$target_library_path" "$depth_next"

			continue
		fi

		if [[ -e "$target_library_path" && ! -d "$target_library_path" ]]; then
			__error "install path exists and is not a directory: %s" "$target_library_path"
			local_exit_failsafe
		fi

		if ! $force_installation_all && same_install; then
			__info "already installed, skipping %s" "$project"
			record_library
			seen["$project"]="installed"

			local depth_next
			depth_next="$((depth + 1))" || __expression_may_fail
			enqueue_nested "$target_library_path" "$depth_next"

			continue
		fi

		if [[ -d "$target_library_path" ]]; then
			__info "backing up previous install of %s" "$project"
			backup_installation_directory "$target_library_path" "$project"
		fi

		__info "installing %s from %s" "$project" "$requirement_download"

		installation_target="$target_library_path"
		mkdir --parents -- "$(dirname -- "$installation_target")"

		local zip_temporary
		zip_temporary="$(__create_temporary_file).zip"
		installation_zip="$zip_temporary"

		local status=0
		__info "downloading %s" "$project"
		curl -fL --retry 3 --retry-delay 2 -o "$zip_temporary" -- "$requirement_download" || status="$(__abort_on_interrupt "$?")"
		if (( status != 0 )); then
			[[ -f "$zip_temporary" ]] && rm -f -- "$zip_temporary"
			installation_zip=""
			installation_target=""
			seen["$project"]="failed"

			__error "download failed: %s" "$requirement_download"
			local_exit_failsafe
		fi

		local actual
		actual="$(sha256sum -- "$zip_temporary" | awk '{print $1}')"
		__info "sha256 of %s: %s" "$requirement_project" "$actual"

		if [[ -n "${requirement_sha256:-}" ]]; then
			if [[ "$actual" != "$requirement_sha256" ]]; then
				rm -f -- "$zip_temporary"
				installation_zip=""
				installation_target=""
				seen["$project"]="failed"
				__error "sha256 mismatch for %s: expected %s, got %s" "$requirement_project" "$requirement_sha256" "$actual"
				local_exit_failsafe
			fi

			__info "sha256 verified for %s" "$requirement_project"
		fi

		__info "extracting %s to %s" "$project" "$target_library_path"
		if ! extract_zip "$zip_temporary" "$target_library_path"; then
			archive_zip "$zip_temporary" "${project}-failed"
			installation_zip=""
			[[ -e "$target_library_path" ]] && backup_installation_directory "$target_library_path" "$project"
			installation_target=""
			seen["$project"]="failed"

			__error "extract failed: %s" "$value"
			local_exit_failsafe
		fi

		installation_zip=""
		local stem="$project"
		if [[ -n "$requirement_tag" ]]; then
			stem="${project}-${requirement_tag}"
		elif [[ -n "$requirement_branch" ]]; then
			stem="${project}-${requirement_branch}"
		fi

		archive_zip "$zip_temporary" "$stem"

		write_installation_settings "$target_library_path"

		handler="$handlers_directory/$project"

		if [[ ! -f "$handler" && -n "${installed_paths["$project"]-}" ]]; then
			handler="${installed_paths["$project"]}/$CONTROL_DIRECTORY/$project"
		fi
		if [[ ! -f "$handler" && -n "$target_library_path" ]]; then
			handler="$target_library_path/$CONTROL_DIRECTORY/$project"
		fi
		if [[ -f "$handler" ]]; then
			__info "sourcing post-installation handler %s" "$handler"
			__require_once "$handler"
			handler_sourced["$project"]=1
		fi
		installation_complete=true
		installation_target=""

		__info "installed %s to %s" "$project" "$target_library_path"
		record_library
		seen["$project"]="installed"

		if [[ -z "${installed_paths["$project"]-}" ]]; then
			installed_paths["$project"]="$target_library_path"
		fi

		local depth_next
		depth_next="$((depth + 1))" || __expression_may_fail
		enqueue_nested "$target_library_path" "$depth_next"
	done
}

function install_package() {
	print_sources=false
	local explicit_update=false

	while (($# > 0)); do
		if [[ "$1" == "--debug" ]]; then
			__debug=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--verbose" ]]; then
			__verbose=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--quiet" ]]; then
			__quiet=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--print" || "$1" == "--print-sources" ]]; then
			print_sources=true
			shift || __expression_may_fail
		elif [[ "$1" == "--installation-root" ]]; then
			if [[ -z "${2-}" ]]; then
				__error "--installation-root requires a path"
				local_exit_failsafe
			fi
			installation_root="$2"
			shift 2 ||__expression_may_fail
		elif [[ "$1" == "--installation-root="* ]]; then
			if [[ -z "${1#--installation-root=}" ]]; then
				__error "--installation-root requires a path"
				local_exit_failsafe
			fi
			installation_root="${1#--installation-root=}"
			shift ||__expression_may_fail
		elif [[ "$1" == "--force-install-all" ]]; then
			force_installation_all=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--force-download-newer" || "$1" == "--update" ]]; then
			force_download_newer=true
			explicit_update=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--update-pinned" ]]; then
			force_download_newer=true
			update_pinned=true
			explicit_update=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--update-to-any-depth" ]]; then
			force_download_newer=true
			update_to_any_depth=true
			explicit_update=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--" ]]; then
			shift ||__expression_may_fail
		else
			__error "unknown program argument %s" "$1"
			local_exit_failsafe
		fi
	done

	# Start every invocation clean so a post-reboot re-call does not inherit
	# update mode or leftover queue/decision state from the previous call.
	if ! $explicit_update; then
		force_download_newer=false
		update_to_any_depth=false
		update_pinned=false
	fi
	queue=()
	processed_files=()
	seen=()
	decided_version=()
	decided_by=()
	pinned_commits=()
	pinned_urls=()
	handler_sourced=()
	registered_handlers=()

	installation_root="${installation_root%"/"}"

	if [[ -z "$installation_root" ]]; then
		__error "installation_root is empty or not set"
		local_exit_failsafe
	fi

	local relative_path
	relative_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

	if [[ -z "${BOOTSTRAPPER_LOADED:-}" ]]; then
		__require_once "$relative_path/bootstrap_install"
	fi

	__info "[%s] installing sourced packages" "__$__current_script_name"

	if ! (cd -- "$installation_root"); then
		__error "cannot cd into installation root: %s" "$installation_root"
		local_exit_failsafe
	fi

	if [[ ! -f "$installation_root/FLAG_IS_PROJECT" ]]; then
		__error "project flag file does not mark installation root: %s" "$installation_root/FLAG_IS_PROJECT"
		local_exit_failsafe
	fi

	bootstrap_install "https://github.com/freywald/sourcetree-datafile-format" "$installation_root/core-library"
	__require_once "$__sourcetree_datafile_format_library_path/library/sourcetree-datafile-format"

	input_file="$(__normalize_path_slashes "$installation_root/$SOURCES_FILE")"
	pinned_file="$(__normalize_path_slashes "$installation_root/$PINNED_FILE")"
	zip_archive_directory="$(__normalize_path_slashes "$installation_root/$ARCHIVE_DOWNLOADS_DIRECTORY/")"
	installation_archive_directory="$(__normalize_path_slashes "$installation_root/$ARCHIVE_INSTALLATIONS_DIRECTORY/")"
	dynamic_file="$(__normalize_path_slashes "$installation_root/$DYNAMIC_FILE")"

	if [[ ! -f "$input_file" ]]; then
		__error "input file not found: %s" "$input_file"
		local_exit_failsafe
	fi

	# Even with --update, remember the commits recorded in the pin file
	if [[ -f "$pinned_file" && -s "$pinned_file" ]]; then
		local pin_name="" pin_commit=""
		while IFS= read -r line || [[ -n "$line" ]]; do
			if [[ "$line" =~ ^#\ name=([A-Za-z0-9_]+)$ ]]; then
				pin_name="${BASH_REMATCH[1]}"
				pin_commit=""
			elif [[ "$line" =~ ^#\ commit=([0-9a-fA-F]+)$ ]]; then
				pin_commit="${BASH_REMATCH[1]}"
				[[ -n "$pin_name" ]] && pinned_commits["$pin_name"]="$pin_commit"
			fi
		done < "$pinned_file"
	fi

	local runtime_file="$installation_root/bootstrapped.dynamic"
	if [[ -f "$runtime_file" ]]; then
		source -- "$runtime_file"
		local variable project
		for variable in ${!__*}; do
			[[ "$variable" != *"_library_path" ]] && continue
			project="${variable#"__"}"
			project="${project%"_library_path"}"
			installed_paths["$project"]="$(__normalize_path_slashes "${!variable%/}")"
		done
	fi

	if [[ -f "$dynamic_file" ]]; then
		source -- "$dynamic_file"
		for variable in ${!__*}; do
			[[ "$variable" != *"_library_path" ]] && continue
			project="${variable#"__"}"
			project="${project%"_library_path"}"
			if [[ -z "${installed_paths["$project"]-}" ]]; then
				installed_paths["$project"]="$(__normalize_path_slashes "${!variable%/}")"
			fi
		done
	fi

	# Detect the same project installed in more than one place
	declare -A project_locations=()
	while IFS= read -r -d '' dir; do
		local name
		name="$(basename -- "$dir")"

		if [[ -f "$dir/$CONTROL_DIRECTORY/$name" ]]; then
			:
		elif [[ -f "$dir/installation-settings.markdown" ]]; then
			name="$(settings_value "$dir/installation-settings.markdown" "project")"
			[[ -z "$name" ]] && name="$(basename -- "$dir")"
		else
			continue
		fi

		if [[ -n "${project_locations["$name"]-}" ]]; then
			__error "duplicate install of %s: %s and %s" "$name" "${project_locations["$name"]}" "$dir"
			local_exit_failsafe
		fi
		project_locations["$name"]="$(__normalize_path_slashes "$dir")"
	done < <(find "$installation_root" -mindepth 2 -maxdepth 2 -type d -print0)

	for name in "${!project_locations[@]}"; do
		if [[ -z "${installed_paths["$name"]-}" ]]; then
			installed_paths["$name"]="${project_locations["$name"]}"
		fi
	done
	unset project_locations

	# Record commit for bootstrapped packages that have none yet
	local project path page commit
	for project in "${!installed_paths[@]}"; do
		path="${installed_paths["$project"]}"
		[[ ! -d "$path" ]] && continue
		[[ "$(settings_value "$path/installation-settings.markdown" "bootstrapped")" != "true" ]] && continue
		[[ -n "$(settings_value "$path/installation-settings.markdown" "commit")" ]] && continue
		page="$(settings_value "$path/installation-settings.markdown" "source url")"
		[[ -z "$page" || "$page" != https://github.com/* ]] && continue
		local status=0
		commit="$(git ls-remote "$page.git" "refs/heads/master" 2>"/dev/null" | awk '{print $1; exit}')" || status="$(__abort_on_interrupt "$?")"
		if (( status != 0 )) || [[ -z "$commit" ]]; then
			continue
		fi
		grep -q '^- commit:' "$path/installation-settings.markdown" || printf -- '- commit: %s\n' "$commit" >> "$path/installation-settings.markdown"
	done

	# Without an explicit --update, check whether bootstrapped packages have newer master commits
	if ! $explicit_update; then
		local project path page pinned_commit remote_commit
		local updates=()
		for project in "${!installed_paths[@]}"; do
			path="${installed_paths["$project"]}"
			[[ "$(settings_value "$path/installation-settings.markdown" "bootstrapped")" != "true" ]] && continue
			[[ ! -d "$path" ]] && continue

			page="$(settings_value "$path/installation-settings.markdown" "source url")"
			[[ -z "$page" ]] && continue

			pinned_commit="${pinned_commits["$project"]-}"
			[[ -z "$pinned_commit" ]] && pinned_commit="$(settings_value "$path/installation-settings.markdown" "commit")"
			[[ -z "$pinned_commit" ]] && continue

			# Only GitHub URLs
			if [[ "$page" != "https://github.com/"* ]]; then
				continue
			fi
			local status=0
			remote_commit="$(git ls-remote "$page.git" "refs/heads/master" 2>"/dev/null" | awk '{print $1; exit}')" || status="$(__abort_on_interrupt "$?")"
			if (( status != 0 )) || [[ -z "$remote_commit" || "$remote_commit" == "$pinned_commit" ]]; then
				continue
			fi

			updates+=("$project")
			__info "update available for %s: %s -> %s" "$project" "$pinned_commit" "$remote_commit"
		done

		if (( ${#updates[@]} > 0 )); then
			if __confirm "Core-library updates are available. Update now?"; then
				force_download_newer=true
				__info "updating bootstrapped libraries"
			else
				__info "continuing without update"
			fi
		fi
	fi

	local rebooted=false
	local -a core_failures=()
	declare -A core_pin_updates=()
	if $force_download_newer; then
		local project path
		for project in "${!installed_paths[@]}"; do
			path="${installed_paths["$project"]}"
			[[ ! -d "$path" ]] && continue

			local settings="$path/installation-settings.markdown"
			[[ ! -f "$settings" ]] && continue

			# Only packages installed by the bootstrapper
			[[ "$(settings_value "$settings" "bootstrapped")" != "true" ]] && continue

			# Pin is the preference; settings is only human-readable
			local installed_commit="${pinned_commits["$project"]-}"
			[[ -z "$installed_commit" ]] && installed_commit="$(settings_value "$settings" "commit")"

			local page commit
			page="$(settings_value "$settings" "source url")"
			[[ -z "$page" ]] && continue

			local status=0
			commit="$(git ls-remote "$page.git" "refs/heads/master" 2>"/dev/null" | awk '{print $1; exit}')" || status="$(__abort_on_interrupt "$?")"
			if (( status != 0 )) || [[ -z "$commit" || "$commit" == "$installed_commit" ]]; then
				continue
			fi

			# Settings already has this commit: only bring the pin forward
			local settings_commit
			settings_commit="$(settings_value "$settings" "commit")"
			if [[ "$settings_commit" == "$commit" ]]; then
				__info "pin for %s is behind settings, updating pin to %s" "$project" "$commit"
				update_pin_commit "$project" "$commit"
				pinned_commits["$project"]="$commit"
				core_pin_updates["$project"]="$commit"
				continue
			fi

			__info "commit changed for %s, re-downloading" "$project"

			# Before backup_installation_directory
			local old_settings_content=""
			if [[ -f "$path/installation-settings.markdown" ]]; then
				old_settings_content="$(cat -- "$path/installation-settings.markdown")"
			fi
			backup_installation_directory "$path" "$project"

			local download_url="${page}/archive/refs/heads/master.zip"
			local zip_temporary
			zip_temporary="$(__create_temporary_file).zip"

			status=0
			curl -fL --retry 3 --retry-delay 2 -o "$zip_temporary" -- "$download_url" || status="$(__abort_on_interrupt "$?")"
			if (( status != 0 )); then
				[[ -f "$zip_temporary" ]] && rm -f -- "$zip_temporary"
				mv -- "$backup_destination" "$path"
				__warn "core update failed for %s (download): %s" "$project" "$download_url"
				core_failures+=("$project")
				continue
			fi

			if ! extract_zip "$zip_temporary" "$path"; then
				[[ -f "$zip_temporary" ]] && rm -f -- "$zip_temporary"
				[[ -e "$path" ]] && rm -rf -- "$path"
				mv -- "$backup_destination" "$path"
				__warn "core update failed for %s (extract)" "$project"
				core_failures+=("$project")
				continue
			fi
			rm -f -- "$zip_temporary"

			# merge: keep every previous key, overwrite only the ones that changed
			declare -A keep=()
			if [[ -n "$old_settings_content" ]]; then
				local line key val
				while IFS= read -r line || [[ -n "$line" ]]; do
					if [[ "$line" =~ ^[[:space:]]*-[[:space:]]*([^:]+):[[:space:]]*(.*)$ ]]; then
						key="$(__trim_whitespaces "${BASH_REMATCH[1]}")"
						val="${BASH_REMATCH[2]}"
						keep["$key"]="$val"
					fi
				done <<< "$old_settings_content"
			fi

			keep["source url"]="$page"
			keep["download url"]="$download_url"
			keep["commit"]="$commit"
			keep["branch"]="$branch_primary"
			keep["install directory"]="$path"
			keep["installed at"]="$(date +%d-%m-%Y-%H-%M-%S)"
			keep["bootstrapped"]="true"
			{
				printf '%s\n' "# installation settings" ""
				local k
				for k in "${!keep[@]}"; do
					printf -- '- %s: %s\n' "$k" "${keep[$k]}"
				done
			} >| "$path/installation-settings.markdown"

			update_pin_commit "$project" "$commit"
			pinned_commits["$project"]="$commit"
			core_pin_updates["$project"]="$commit"

			rebooted=true
		done

		if (( ${#core_failures[@]} > 0 )); then
			__error "core-library updates failed for: %s" "${core_failures[*]}"
			local_exit_failsafe
		fi
	fi

	if $rebooted; then
		__info "bootstrapped libraries updated, reboot required"
		force_download_newer=false
		return "$EXIT_REBOOT"
	fi

	# A confirm only authorised core updates
	if ! $explicit_update; then
		force_download_newer=false
	fi

	# Decide which sources file to use for the package queue.
	# A post-reboot call (explicit_update=false) always prefers the pin file.
	source_file="$input_file"
	if $explicit_update; then
		__info "updating from %s" "$input_file"
	elif [[ -f "$pinned_file" && -s "$pinned_file" ]]; then
		source_file="$pinned_file"
		__info "requirements are pinned; using %s" "$pinned_file"
	else
		__info "no pin file; using %s" "$input_file"
	fi

	# Source handlers for every installed project, not only those seen in sources
	local project path handler
	for project in "${!installed_paths[@]}"; do
		[[ -n "${handler_sourced["$project"]-}" ]] && continue
		path="${installed_paths["$project"]}"
		[[ ! -d "$path" ]] && continue

		handler="$path/$CONTROL_DIRECTORY/$project"
		if [[ -f "$handler" ]]; then
			__info "sourcing handler for installed %s" "$project"
			source -- "$handler"
			handler_sourced["$project"]=1
		fi
	done

	mkdir --parents -- "$zip_archive_directory" "$installation_archive_directory" "$(dirname -- "$dynamic_file")"

	dynamic_partial="$(__create_temporary_file)"
	pinned_partial="$(__create_temporary_file)"
	installation_target=""
	installation_zip=""
	installation_complete=false

	trap 'abandon_partial $EXIT_INTERRUPTED' "INT"
	trap 'abandon_partial $EXIT_TERMINATED' "TERM"

	__info "[%s] building bibliography" "__$__current_script_name"

	# Seed the queue with the top-level sources
	queue+=("$source_file"$'\t'"0")

	# Also seed with sources from every already-installed (bootstrapped) package
	local project path nested
	for project in "${!installed_paths[@]}"; do
		path="${installed_paths["$project"]}"
		[[ ! -d "$path" ]] && continue

		nested=""
		if [[ -f "$path/$PINNED_FILE" ]] && ! $force_download_newer; then
			nested="$path/$PINNED_FILE"
		elif [[ -f "$path/$SOURCES_FILE" ]]; then
			nested="$path/$SOURCES_FILE"
		fi

		[[ -z "$nested" ]] && continue
		# Avoid enqueueing the top-level file twice
		[[ "$nested" == "$source_file" ]] && continue

		queue+=("$nested"$'\t'"0"$'\t'"$project")
	done

	while ((${#queue[@]} > 0)); do
		entry="${queue[0]}"
		queue=("${queue[@]:1}")

		file="${entry%%$'\t'*}"
		rest="${entry#*$'\t'}"
		depth="${rest%%$'\t'*}"
		requester="${rest#*$'\t'}"
		[[ "$requester" == "$depth" ]] && requester="top-level"

		process_requirement "$file" "$depth" "$requester"
	done

	# Merge bootstrapped.dynamic into the normal dynamic file, then remove it
	if [[ -f "$runtime_file" ]]; then
		local line project
		while IFS= read -r line || [[ -n "$line" ]]; do
			# Extract project name from __PROJECT_library_path=…
			if [[ "$line" =~ ^__([A-Za-z0-9_]+)_library_path= ]]; then
				project="${BASH_REMATCH[1]}"
				# Only append if this project is not already recorded
				if ! grep -q -- "^__${project}_library_path=" "$dynamic_partial"; then
					printf '%s\n' "$line" >> "$dynamic_partial"
				fi
			fi
		done < "$runtime_file"
		rm -f -- "$runtime_file"
	fi

	mv -f -- "$dynamic_partial" "$dynamic_file"
	if [[ -s "$pinned_partial" ]]; then
		mv -f -- "$pinned_partial" "$pinned_file"
	else
		rm -f -- "$pinned_partial"
	fi

	local pin_project
	for pin_project in "${!core_pin_updates[@]}"; do
		update_pin_commit "$pin_project" "${core_pin_updates["$pin_project"]}"
	done

	if [[ -f "$dynamic_file" ]]; then
		source -- "$dynamic_file"
	fi

	trap - "INT" "TERM"

	__heading "Checking handlers"

	missing=false
	for project in "${!installed_paths[@]}"; do
		if [[ -z "${handler_sourced["$project"]-}" ]]; then
			__warn "handler file missing for %s" "$project"
			missing=true
		fi
	done

	if $missing; then
		__error "Installation failed"
		local_exit_failsafe
	fi

	__heading "Running handlers"
	for project in "${!seen[@]}"; do
		if [[ "${seen["$project"]}" == "failed" ]]; then
			__error "installation failed for %s, skipping handlers" "$project"
			local_exit_failsafe
		fi
	done

	if ! run_handlers; then
		__error "one or more handlers failed"
		local_exit_failsafe
	fi

	__info "[%s] done." "__$__current_script_name"
}
